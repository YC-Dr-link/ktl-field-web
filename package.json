{
  "name": "ktl-field-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode mobile",
    "dev:admin": "vite --mode admin",
    "build": "tsc -b && vite build --mode mobile && vite build --mode admin && node scripts/check-offline.mjs",
    "preview": "vite preview --mode mobile",
    "gen:api": "openapi-typescript https://raw.githubusercontent.com/YC-Dr-link/ktl-hub/main/docs/api/field-server.openapi.yaml -o src/api/schema.d.ts"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "msw": "2.6.8",
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
